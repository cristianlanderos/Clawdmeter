#!/usr/bin/env python3
"""Add (or remove) the Clawdmeter prompt hook in Claude Code config dirs.

    clawdmeter-hook-install DIR [DIR ...]          # add / update the hook
    clawdmeter-hook-install --remove DIR [DIR ...] # take it out again

For each DIR this edits DIR/settings.json: it registers
daemon/clawdmeter-prompt-hook as a UserPromptSubmit hook, so the daemon knows
which plan you last prompted in. Every other setting and hook is kept. Running
it twice is safe: an existing Clawdmeter entry is replaced, not duplicated.

Stdlib only, Python 3.7+, so the system python3 on macOS and Linux can run it.
"""
from __future__ import annotations

import json
import os
import shlex
import sys
import tempfile
from pathlib import Path

HOOK_NAME = "clawdmeter-prompt-hook"
HOOK_SCRIPT = Path(__file__).resolve().parent / HOOK_NAME
EVENT = "UserPromptSubmit"


def _is_ours(hook: object) -> bool:
    return isinstance(hook, dict) and HOOK_NAME in str(hook.get("command", ""))


def strip_hook(settings: dict) -> dict:
    """Return settings without any Clawdmeter prompt-hook entry."""
    hooks = settings.get("hooks")
    if not isinstance(hooks, dict) or not isinstance(hooks.get(EVENT), list):
        return settings
    groups = []
    for group in hooks[EVENT]:
        if isinstance(group, dict) and isinstance(group.get("hooks"), list):
            kept = [h for h in group["hooks"] if not _is_ours(h)]
            if not kept:
                continue          # the group held only our hook
            group = dict(group, hooks=kept)
        groups.append(group)
    hooks = dict(hooks)
    if groups:
        hooks[EVENT] = groups
    else:
        hooks.pop(EVENT)
    settings = dict(settings)
    if hooks:
        settings["hooks"] = hooks
    else:
        settings.pop("hooks")
    return settings


def add_hook(settings: dict, config_dir: Path) -> dict:
    """Return settings with exactly one Clawdmeter prompt-hook entry."""
    settings = strip_hook(settings)
    command = f"{shlex.quote(str(HOOK_SCRIPT))} {shlex.quote(str(config_dir))}"
    hooks = dict(settings.get("hooks") or {})
    groups = list(hooks.get(EVENT) or [])
    groups.append({"hooks": [{"type": "command", "command": command, "timeout": 5}]})
    hooks[EVENT] = groups
    settings = dict(settings)
    settings["hooks"] = hooks
    return settings


def edit(config_dir: Path, remove: bool) -> bool:
    path = config_dir / "settings.json"
    settings: dict = {}
    if path.exists():
        try:
            settings = json.loads(path.read_text() or "{}")
        except (OSError, ValueError) as e:
            print(f"  {path}: not valid JSON ({e}); left unchanged", file=sys.stderr)
            return False
        if not isinstance(settings, dict):
            print(f"  {path}: not a JSON object; left unchanged", file=sys.stderr)
            return False
    elif remove:
        return True
    new = strip_hook(settings) if remove else add_hook(settings, config_dir)
    if new == settings and path.exists():
        return True
    config_dir.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(config_dir), prefix=".settings.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(new, f, indent=2)
            f.write("\n")
        if path.exists():
            os.chmod(tmp, path.stat().st_mode & 0o777)
        os.replace(tmp, path)
    except OSError as e:
        os.unlink(tmp)
        print(f"  {path}: write failed ({e})", file=sys.stderr)
        return False
    print(f"  {'Removed hook from' if remove else 'Hook set in'} {path}")
    return True


def main(argv: list) -> int:
    remove = "--remove" in argv
    dirs = [a for a in argv if a != "--remove"]
    if not dirs or any(a.startswith("-") for a in dirs):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    ok = True
    for d in dirs:
        ok = edit(Path(d).expanduser(), remove) and ok
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
